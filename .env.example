# Local Node execution: point to your PostgreSQL/Supabase database.
DATABASE_URL=postgresql://affirmative:affirmative@localhost:5432/affirmative_pill

# worker = Docker projector service consumes events asynchronously.
# inline = useful on Vercel: the query side projects pending events before reading.
PROJECTION_MODE=worker

# Optional delay used only by the background projector, useful to demonstrate eventual consistency.
PROJECTION_POLL_MS=700
